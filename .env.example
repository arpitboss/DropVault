# ==============================================================================
# DropVault Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# Note: NEVER commit the actual .env file or production encryption keys to Git.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration (debug | info | warn | error)
LOG_LEVEL=info

# MongoDB Connection
# - Local standalone development: mongodb://localhost:27017/dropvault
# - Docker Compose environment:   mongodb://mongo:27017/dropvault
MONGODB_URI=mongodb://localhost:27017/dropvault

# Cryptography (AES-256-GCM Master Key / Key Encryption Key)
# Must be exactly 64 hexadecimal characters (32 raw bytes).
# Generate a new random key with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage Configuration
# - Local standalone development: ./uploads
# - Docker Compose environment:   /app/uploads
UPLOAD_DIR=./uploads

# Maximum File Size in bytes (default: 50MB = 52428800 bytes)
MAX_FILE_SIZE=52428800

# Maximum Text Paste Size in bytes (default: 1MB = 1048576 bytes)
MAX_TEXT_SIZE=1048576

# Redis Connection (V1-T01)
# - Local standalone development: REDIS_HOST=localhost
# - Docker Compose environment:   REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional password for authenticated Redis instances
REDIS_PASSWORD=

